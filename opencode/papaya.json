{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "carbon": "#0c0d0f",
    "carbonDeep": "#08090b",
    "carbonLift": "#1a1c1f",
    "ink": "#f4f5f6",
    "inkSoft": "#a3a8ae",
    "muted": "#938e86",
    "papaya": "#ff8000",
    "rose": "#e8456b",
    "roseBright": "#f0849d",
    "gold": "#f0d060",
    "goldBright": "#f5e096",
    "green": "#6fbf78",
    "greenBright": "#a0d5a6",
    "cyan": "#5fd0d0",
    "blue": "#6cb6ff",
    "violet": "#c792ea",
    "paper": "#f7f3ee",
    "paperPanel": "#efe8df",
    "paperElement": "#e7ddd0",
    "paperLine": "#d9cfc3",
    "inkDeep": "#1c140f",
    "mutedDeep": "#6e655c",
    "papayaDeep": "#9a3412",
    "roseDeep": "#c4234a",
    "goldDeep": "#8a5a00",
    "greenDeep": "#1f7a3a",
    "cyanDeep": "#0f6e68",
    "blueDeep": "#1d4ed8",
    "violetDeep": "#6d28d9"
  },
  "theme": {
    "primary": { "dark": "papaya", "light": "papayaDeep" },
    "secondary": { "dark": "blue", "light": "blueDeep" },
    "accent": { "dark": "papaya", "light": "papayaDeep" },
    "error": { "dark": "rose", "light": "roseDeep" },
    "warning": { "dark": "gold", "light": "goldDeep" },
    "success": { "dark": "green", "light": "greenDeep" },
    "info": { "dark": "cyan", "light": "cyanDeep" },
    "text": { "dark": "ink", "light": "inkDeep" },
    "textMuted": { "dark": "muted", "light": "mutedDeep" },
    "background": { "dark": "carbon", "light": "paper" },
    "backgroundPanel": { "dark": "carbonDeep", "light": "paperPanel" },
    "backgroundElement": { "dark": "carbonLift", "light": "paperElement" },
    "border": { "dark": "carbonLift", "light": "paperLine" },
    "borderActive": { "dark": "papaya", "light": "papayaDeep" },
    "borderSubtle": { "dark": "carbonDeep", "light": "paperElement" },
    "diffAdded": { "dark": "green", "light": "greenDeep" },
    "diffRemoved": { "dark": "rose", "light": "roseDeep" },
    "diffContext": { "dark": "muted", "light": "mutedDeep" },
    "diffHunkHeader": { "dark": "blue", "light": "blueDeep" },
    "diffHighlightAdded": { "dark": "greenBright", "light": "greenDeep" },
    "diffHighlightRemoved": { "dark": "roseBright", "light": "roseDeep" },
    "diffAddedBg": { "dark": "#132018", "light": "#e5f2e8" },
    "diffRemovedBg": { "dark": "#241418", "light": "#f8e6ea" },
    "diffContextBg": { "dark": "carbonDeep", "light": "paperPanel" },
    "diffLineNumber": { "dark": "muted", "light": "mutedDeep" },
    "diffAddedLineNumberBg": { "dark": "#132018", "light": "#e5f2e8" },
    "diffRemovedLineNumberBg": { "dark": "#241418", "light": "#f8e6ea" },
    "markdownText": { "dark": "ink", "light": "inkDeep" },
    "markdownHeading": { "dark": "papaya", "light": "papayaDeep" },
    "markdownLink": { "dark": "blue", "light": "blueDeep" },
    "markdownLinkText": { "dark": "cyan", "light": "cyanDeep" },
    "markdownCode": { "dark": "green", "light": "greenDeep" },
    "markdownBlockQuote": { "dark": "muted", "light": "mutedDeep" },
    "markdownEmph": { "dark": "gold", "light": "goldDeep" },
    "markdownStrong": { "dark": "papaya", "light": "papayaDeep" },
    "markdownHorizontalRule": { "dark": "muted", "light": "mutedDeep" },
    "markdownListItem": { "dark": "papaya", "light": "papayaDeep" },
    "markdownListEnumeration": { "dark": "gold", "light": "goldDeep" },
    "markdownImage": { "dark": "blue", "light": "blueDeep" },
    "markdownImageText": { "dark": "cyan", "light": "cyanDeep" },
    "markdownCodeBlock": { "dark": "ink", "light": "inkDeep" },
    "syntaxComment": { "dark": "muted", "light": "mutedDeep" },
    "syntaxKeyword": { "dark": "violet", "light": "violetDeep" },
    "syntaxFunction": { "dark": "blue", "light": "blueDeep" },
    "syntaxVariable": { "dark": "ink", "light": "inkDeep" },
    "syntaxString": { "dark": "green", "light": "greenDeep" },
    "syntaxNumber": { "dark": "gold", "light": "goldDeep" },
    "syntaxType": { "dark": "cyan", "light": "cyanDeep" },
    "syntaxOperator": { "dark": "papaya", "light": "papayaDeep" },
    "syntaxPunctuation": { "dark": "inkSoft", "light": "mutedDeep" }
