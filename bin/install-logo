#!/bin/bash
# Put the McLaren speedmark on the bar in place of the Omarchy logo, and
# install the McLaren screensaver that ships with this theme.
# Quiet when the theme-set hook calls this during `omarchy theme install`.
set -euo pipefail

quiet=0
revert=0
for arg in "$@"; do
  case "$arg" in
    --quiet) quiet=1 ;;
    --revert) revert=1 ;;
  esac
done

root=$(cd "$(dirname "$0")/.." && pwd)
state_dir="${HOME}/.local/state/omarchy"

reload_opencode() {
  if pgrep -x opencode >/dev/null 2>&1; then
    killall -SIGUSR2 opencode >/dev/null 2>&1 || true
  fi
}

install_prompt() {
  local dest="${HOME}/.config/starship.toml"
  local src="$root/starship.toml"
  local backup="${state_dir}/papaya-starship.toml"
  local created="${state_dir}/papaya-starship-created"
  [[ -f $src ]] || return 0
  mkdir -p "${HOME}/.config" "$state_dir"
  if [[ ! -f $dest ]]; then
    cp "$src" "$dest"
    touch "$created"
    return 0
  fi
  if grep -q '# papaya-starship' "$dest"; then
    cp "$src" "$dest"
    return 0
  fi
  # The prompt written before this file carried a marker.
  if grep -q '#ff8000' "$dest" && grep -q '#ff5c45' "$dest"; then
    [[ -f $backup ]] || cp "$dest" "$backup"
    cp "$src" "$dest"
  fi
}

revert_prompt() {
  local dest="${HOME}/.config/starship.toml"
  local backup="${state_dir}/papaya-starship.toml"
  local created="${state_dir}/papaya-starship-created"
  [[ -f $dest ]] || return 0
  grep -q '# papaya-starship' "$dest" || return 0
  if [[ -f $backup ]]; then
    cp "$backup" "$dest"
    rm -f "$backup"
  elif [[ -f $created ]]; then
    rm -f "$dest" "$created"
  fi
}

install_opencode() {
  local themes="${HOME}/.config/opencode/themes"
  [[ -f $root/opencode/papaya.json ]] || return 0
  mkdir -p "$themes" "$state_dir"
  cp "$root/opencode/papaya.json" "$themes/papaya.json"
  python3 - "$state_dir" <<'PY'
import json
import sys
from pathlib import Path

state = Path(sys.argv[1])
home = Path.home()

def load(path):
    if not path.exists():
        return None
    return json.loads(path.read_text())

def dump(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2) + "\n")

def remember(path, previous):
    if path.exists():
        return
    path.write_text(previous + "\n")

tui_path = home / ".config/opencode/tui.json"
tui_state = state / "papaya-opencode-tui-theme"
tui = load(tui_path)
if tui is None:
    remember(tui_state, "__missing__")
    tui = {"$schema": "https://opencode.ai/tui.json", "theme": "papaya"}
else:
    previous = tui.get("theme", "system")
    if isinstance(previous, str) and previous != "papaya":
        remember(tui_state, previous)
    tui["theme"] = "papaya"
dump(tui_path, tui)

cli_path = home / ".config/opencode/cli.json"
cli_state = state / "papaya-opencode-cli-theme"
cli = load(cli_path)
if cli is None:
    remember(cli_state, "__missing__")
    cli = {"$schema": "https://opencode.ai/v2/cli.json", "theme": {"name": "papaya"}}
else:
    theme = cli.get("theme")
    if isinstance(theme, dict):
        previous = str(theme.get("name", "system"))
        theme["name"] = "papaya"
        cli["theme"] = theme
    elif isinstance(theme, str):
        previous = theme
        cli["theme"] = {"name": "papaya"}
    else:
        previous = "system"
        cli["theme"] = {"name": "papaya"}
    if previous != "papaya":
        remember(cli_state, previous)
dump(cli_path, cli)
PY
  reload_opencode
}

revert_opencode() {
  python3 - "$state_dir" <<'PY'
import json
import sys
from pathlib import Path

state = Path(sys.argv[1])
home = Path.home()

def load(path):
    if not path.exists():
        return None
    return json.loads(path.read_text())

def dump(path, data):
    path.write_text(json.dumps(data, indent=2) + "\n")

tui_path = home / ".config/opencode/tui.json"
tui_state = state / "papaya-opencode-tui-theme"
if tui_state.exists() and tui_path.exists():
    previous = tui_state.read_text().strip()
    tui = load(tui_path) or {}
    if tui.get("theme") == "papaya":
        if previous == "__missing__":
            tui_path.unlink()
        else:
            tui["theme"] = previous
            dump(tui_path, tui)
    tui_state.unlink()

cli_path = home / ".config/opencode/cli.json"
cli_state = state / "papaya-opencode-cli-theme"
if cli_state.exists() and (cli_path.exists() or cli_state.read_text().strip() == "__missing__"):
    previous = cli_state.read_text().strip()
    if previous == "__missing__":
        if cli_path.exists():
            cli = load(cli_path) or {}
            theme = cli.get("theme")
            if isinstance(theme, dict) and theme.get("name") == "papaya":
                cli_path.unlink()
    elif cli_path.exists():
        cli = load(cli_path) or {}
        theme = cli.get("theme")
        if isinstance(theme, dict) and theme.get("name") == "papaya":
            theme["name"] = previous
            cli["theme"] = theme
            dump(cli_path, cli)
        elif theme == "papaya":
            cli["theme"] = previous
            dump(cli_path, cli)
    cli_state.unlink()
PY
  reload_opencode
}

if (( revert == 1 )); then
  revert_prompt
  revert_opencode
  exit 0
fi
plugin_id="papaya.logo"
plugin_dir="${HOME}/.config/omarchy/plugins/${plugin_id}"
shell_json="${HOME}/.config/omarchy/shell.json"
branding_dir="${HOME}/.config/omarchy/branding"
hook_dir="${HOME}/.config/omarchy/hooks/theme-set.d"

mkdir -p "$plugin_dir" "$branding_dir" "$hook_dir"
cp -a "$root/logo/." "$plugin_dir/"
chmod 755 "$plugin_dir"

if [[ -f $root/screensaver.txt ]]; then
  branding="${branding_dir}/screensaver.txt"
  saved="${branding_dir}/screensaver.txt.pre-papaya"
  if [[ -f $branding ]] && ! cmp -s "$branding" "$root/screensaver.txt"; then
    cp "$branding" "$saved"
  fi
  cp "$root/screensaver.txt" "$branding"
fi

if [[ -f $root/hooks/papaya-screensaver.hook ]]; then
  cp "$root/hooks/papaya-screensaver.hook" "${hook_dir}/papaya-screensaver.hook"
  chmod 755 "${hook_dir}/papaya-screensaver.hook"
fi

# McLaren papaya is the accent. The nearest named GNOME accent is orange.
accent_state="${HOME}/.local/state/omarchy/papaya-previous-accent"
if command -v gsettings >/dev/null 2>&1 && [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
  mkdir -p "${HOME}/.local/state/omarchy"
  if [[ ! -f $accent_state ]]; then
    current=$(gsettings get org.gnome.desktop.interface accent-color || true)
    if [[ -n ${current:-} && $current != "'orange'" ]]; then
      printf '%s\n' "$current" >"$accent_state"
    fi
  fi
  gsettings set org.gnome.desktop.interface accent-color orange || true
fi

python3 - "$shell_json" "$plugin_id" <<'PY'
import json
import sys
from pathlib import Path

path, plugin_id = Path(sys.argv[1]), sys.argv[2]
previous = {"omarchy.menu", "maplepreneur.mclaren-logo", plugin_id}
data = json.loads(path.read_text()) if path.exists() else {}
bar = data.setdefault("bar", {})
layout = bar.setdefault("layout", {})
placed = False

for section in ("left", "center", "right"):
    items = layout.get(section)
    if not isinstance(items, list):
        continue
    kept = []
    for item in items:
        entry = item if isinstance(item, dict) else {"id": item}
        widget_id = entry.get("id")
        if widget_id in previous:
            if placed:
                continue
            entry["id"] = plugin_id
            placed = True
        kept.append(entry)
    layout[section] = kept

if not placed:
    layout.setdefault("left", [])
    layout["left"].insert(0, {"id": plugin_id})

path.write_text(json.dumps(data, indent=2) + "\n")
PY

# The old logo plugin id is no longer on the bar.
if [[ -d ${HOME}/.config/omarchy/plugins/maplepreneur.mclaren-logo ]]; then
  rm -rf "${HOME}/.config/omarchy/plugins/maplepreneur.mclaren-logo"
fi

if command -v omarchy-shell >/dev/null 2>&1; then
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
fi

if [[ -x $root/bin/browser-highlight ]]; then
  "$root/bin/browser-highlight" install
fi

install_prompt
install_opencode

if (( quiet == 0 )); then
  echo "McLaren logo is on the bar (${plugin_id})."
  echo "Left click opens the menu. Right click opens a terminal."
  echo "Screensaver installed to ${branding_dir}/screensaver.txt"
  echo "Selected text in Chrome and Chromium is papaya #ff8000 after a browser restart."
  echo "Prompt and OpenCode use the Papaya palette."
fi
