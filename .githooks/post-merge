#!/bin/bash
# After `omarchy theme update` pulls this theme, rebuild the live desktop
# from colors.toml when Papaya is the theme in use.
export PATH="/usr/share/omarchy/bin:${PATH:-/usr/bin}"
set -euo pipefail

name_file="${HOME}/.local/state/omarchy/current/theme.name"
[[ -f $name_file ]] || exit 0

current=$(tr -d '[:space:]' <"$name_file")
[[ $current == "papaya" ]] || exit 0

root=$(git rev-parse --show-toplevel)
plugin="${HOME}/.config/omarchy/plugins/papaya.logo"
if [[ -d $plugin && -d $root/logo ]]; then
  cp -a "$root/logo/." "$plugin/"
fi
if [[ -f $root/screensaver.txt ]]; then
  mkdir -p "${HOME}/.config/omarchy/branding"
  cp "$root/screensaver.txt" "${HOME}/.config/omarchy/branding/screensaver.txt"
fi

omarchy-theme-refresh
