#!/bin/bash
# After `omarchy theme update` pulls this theme, rebuild the live desktop
# from colors.toml when Papaya is the theme in use.
export PATH="/usr/share/omarchy/bin:${PATH:-/usr/bin}"
set -euo pipefail

name_file="${HOME}/.local/state/omarchy/current/theme.name"
[[ -f $name_file ]] || exit 0

current=$(tr -d '[:space:]' <"$name_file")
[[ $current == "papaya" ]] || exit 0

root=$(git rev-parse --show-toplevel)
hook_dir="${HOME}/.config/omarchy/hooks/theme-set.d"
if [[ -f $root/hooks/papaya-screensaver.hook ]]; then
  mkdir -p "$hook_dir"
  cp "$root/hooks/papaya-screensaver.hook" "${hook_dir}/papaya-screensaver.hook"
  chmod 755 "${hook_dir}/papaya-screensaver.hook"
fi

omarchy-theme-refresh
